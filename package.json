{
  "name": "psge",
  "private": true,
  "version": "0.0.0",
  "description": "Pleasantly Simple Game Engine monorepo",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @psge/endless-dig",
    "build": "npm run build -w @psge/engine && npm run build -w @psge/endless-dig",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
